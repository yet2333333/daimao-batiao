# 复制本文件为 .env，填入你自己的值。
# .env 已被 .gitignore 忽略，不会被提交到版本库。

# ---- AI 对话 ----
# 兼容 OpenAI 消息格式的任意接口：DeepSeek / 通义 / 本地 Ollama / 自建网关
DEEPSEEK_API_KEY=sk-你自己的密钥
DEEPSEEK_API_BASE=https://api.deepseek.com/v1/chat/completions
# 模型名，各服务商不同：DeepSeek 官方填 deepseek-chat
# 通义填 qwen-plus；本地 Ollama 填实际拉取的模型名；自建网关填网关约定的名字
MODEL_NAME=deepseek-chat

# ---- 化工知识库（可选，留空则自动关闭检索功能）----
# Markdown 知识库根目录
KB_ROOT=
# SQLite FTS5 全文索引文件路径
RAG_DB=

# ---- 周报导出 ----
# Excel 表内署名，默认「我」
USER_DISPLAY_NAME=我
# 表头的公司 / 部门名称，留空则该单元格为空
COMPANY_NAME=
# 周报输出目录，默认 桌面/<署名>周报
REPORT_DIR=

# ---- 数据目录 ----
# 待办 / 日程 / 统计文件的存放位置。
# 留空 = 程序目录下的 data/（推荐，数据跟着程序走）
# 想让新版继续读写旧版本的数据，就填旧数据目录的绝对路径
DATA_DIR=

# ---- SOP 文档目录 ----
# 留空 = 自动查找 程序目录/sop、上级目录/sop、桌面/sop
SOP_DIR=
